@model List<Category>
@if (TempData["success"]!=null)
{
    <h2>@TempData["success"]</h2>
}
  <div class="container">
	 <div class="row pt-4 pb-23">
		<div class=" col-6">
			<h2 clacc= "text-pimary">
                Тетрадь смерти
			</h2>
	    </div>
	    <div class="col-6 text-end">
			<a asp-controller="Category" asp-action="Create" class="btn btn-dark">	
				<i class="bi bi-sign-dead-end"></i> Умереть
			</a>
		</div>
	</div>
</div>


<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Имя</th>
            <th>Фамилия</th>
            <th>Действие</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var obj in Model)
        {
            <tr>
                <td>@obj.Name</td>
                <td>@obj.Surname</td>
                <td>
                    <div class="w-75 tbn-group" role="group">
                        <a asp-controller="Category" asp-action="Delete" asp-route-id="@obj.Id" class="btn-dark mx-2">
                            <i class="bi bi-pencil-square"></i>Delete
                        </a>
                    </div>
                    
                </td>
            </tr>
        }
    </tbody>
</table>
