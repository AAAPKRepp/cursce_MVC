@model Category

<form method="post" asp-action="Create">
    <div class="row pb-2">
        <h2 class="text-white">Тетрадь смерти ебать</h2>
        <hr />
    </div>
    <div class="mb-3">
        <label class="text-white me-2">Имя нахуй</label>
        <input type="text" asp-for="Name" class="form-control w-25" required />
    </div>
    <div class="mb-3">
        <label class="text-white me-2">Фамилия блять</label>
        <input type="text" asp-for="Surname" class="form-control w-25" required />
    </div>
    <div class="mb-3">
        <label class="text-white me-2">Причина смерти</label>
        <select asp-for="CauseOfDeath" class="form-control w-25">
        <option value="Сердечный приступ">Сердечный приступ</option>
        <option value="random">Зарандомить</option>
        </select>
    </div>
    <div class="row text-center mt-4">
        <div class="mb-3 d-flex gap-3">
            <button type="submit" class="btn btn-danger btn-lg">Умираю</button>
        </div>
        <div class="d-flex gap-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-lg">
                Не буду умирать
            </a>
        </div>
    </div>
</form>
